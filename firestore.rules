rules_version = '2';

// Reglas de seguridad de Firestore para Control de Almacén.
// Copiar en: Firebase Console → Firestore Database → Reglas → Publicar.
//
// Modelo (igual que en index.html):
//   - Solo entra quien tiene sesión Y un documento en usuarios/{correo}.
//   - Solo un admin puede crear/editar permisos (colección usuarios).
//   - La bitácora (movimientos) no se puede editar ni borrar.
//   - El kardex no se puede borrar; solo admin/eliminar lo corrige (fusión).
//   - El maestro de participantes solo lo edita un admin.
//   - Registro fotográfico: cada usuario solo ve los suyos (admin o "rf_todos" ven todos).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function userPath() {
      return /databases/$(database)/documents/usuarios/$(request.auth.token.email);
    }
    function registered() {
      return signedIn() && exists(userPath());
    }
    function perms() {
      return get(userPath()).data.get('permisos', {});
    }
    function isAdmin() {
      return registered() && perms().get('admin', false) == true;
    }
    function canDelete() {
      return registered()
        && (perms().get('admin', false) == true || perms().get('eliminar', false) == true);
    }
    // Ve los registros fotográficos de todos (admin o permiso "rf_todos").
    function rfTodos() {
      return registered()
        && (perms().get('admin', false) == true || perms().get('rf_todos', false) == true);
    }
    function esDuenoRF() {
      return resource.data.get('usuario_email', '') == request.auth.token.email;
    }
    // Participantes cuyos registros fotográficos puede ver (aunque los haya hecho otro usuario).
    function rfDeSuParticipante() {
      return resource.data.get('participante', '') in perms().get('rf_participantes', []);
    }

    // Permisos de usuarios: cada quien lee el suyo; solo admin escribe.
    match /usuarios/{email} {
      allow read: if signedIn() && (request.auth.token.email == email || isAdmin());
      allow create, update, delete: if isAdmin();
      // Arranque: el administrador principal puede crear su propio documento
      // la primera vez (loadPermisos en index.html).
      allow create: if signedIn()
        && request.auth.token.email == email
        && email == 'mramos@corporaciongrit.com';
    }

    // Bitácora: solo se agregan registros, nunca se modifican ni borran.
    match /movimientos/{id} {
      allow read, create: if registered();
      allow update, delete: if false;
    }

    // Kardex: se agregan registros; solo admin/eliminar corrige (fusión de
    // productos); nadie borra.
    match /kardex/{id} {
      allow read, create: if registered();
      allow update: if canDelete();
      allow delete: if false;
    }

    // Maestro de participantes (tiendas): todos lo leen; solo admin lo edita.
    match /participantes_maestro/{id} {
      allow read: if registered();
      allow create, update, delete: if isAdmin();
    }

    // Registro fotográfico: cada usuario ve y trabaja sus registros; además ve los de los
    // participantes que tenga permitidos (permisos.rf_participantes); admin y "rf_todos" ven todos.
    // resource == null: leer un registro que todavía no existe (al generar el correlativo).
    match /registros_foto/{id} {
      allow read: if registered() && (resource == null || esDuenoRF() || rfTodos() || rfDeSuParticipante());
      allow create: if registered()
        && (request.resource.data.get('usuario_email', '') == request.auth.token.email || rfTodos());
      allow update: if registered() && (esDuenoRF() || rfTodos() || canDelete());
      allow delete: if registered() && (esDuenoRF() || canDelete());
    }

    // Link público de Venta Online para el cliente: cualquiera que tenga el link puede leer
    // ESE documento (su id es un código aleatorio de 32 caracteres, imposible de adivinar);
    // nadie puede listar la colección. Solo los usuarios registrados lo crean o cambian
    // (eso lo cubre la regla general de abajo).
    match /vo_publico/{id} {
      allow get: if true;
    }

    // Resto de colecciones de la app: cualquier usuario registrado.
    match /{coleccion}/{id} {
      allow read, write: if registered()
        && !(coleccion in ['usuarios', 'movimientos', 'kardex', 'participantes_maestro', 'registros_foto']);
    }
  }
}
